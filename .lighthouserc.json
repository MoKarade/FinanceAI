{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "is-on-https": "off",
        "uses-http2": "off",
        "redirects-http": "off",
        "color-contrast": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "image-alt": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "html-has-lang": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "meta-viewport": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": "warn",
        "no-document-write": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
